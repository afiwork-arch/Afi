# ── Google Sheets ────────────────────────────────────────────
# サービスアカウントの秘密鍵JSON（Google Cloud Consoleで発行し、対象シートを共有する）
GOOGLE_SERVICE_ACCOUNT_JSON=./config/service_account.json
# 比較データを置くスプレッドシートのID（URLの /d/ と /edit の間の文字列）
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET_NAME=services

# ── バリューコマース 商品API ─────────────────────────────────
# 管理画面「ツール」>「Webサービス」で発行されるトークン。
# 「Webサービス対応プログラム」で提携している広告主のみ取得対象になる点に注意。
VALUECOMMERCE_TOKEN=

# ── A8.net ───────────────────────────────────────────────────
# 通常のメディア会員が使える自己サービス型の「料金/成果取得API」は現時点で存在しない。
# 管理画面の「レポート」からCSVを手動エクスポートし、このフォルダに置く運用にする。
A8NET_REPORT_CSV_DIR=./data/a8net_reports

# ── AccessTrade ──────────────────────────────────────────────
# 要ログイン: パートナー管理画面 > ツール/API メニューでリファレンスと認証情報を確認して設定する。
# （ここに書いてあるキー名は雛形の想定であり、実際のヘッダー名/エンドポイントは管理画面で要確認）
ACCESSTRADE_API_TOKEN=
ACCESSTRADE_API_BASE_URL=

# ── SEOレポート（python -m src.seo_report）用 ─────────────────
# Search Console側で GOOGLE_SERVICE_ACCOUNT_JSON のサービスアカウントに
# 「設定 > ユーザーと権限」から閲覧権限を付与しておく必要がある。
# Cloudflareダッシュボード「My Profile > API Tokens」で Account Analytics: Read
# 権限のトークンを発行する（デプロイ用トークンとは別に作ること）。
CLOUDFLARE_ANALYTICS_TOKEN=
# Cloudflareダッシュボードの「Account details」に表示されているAccount ID（機密情報ではない）
CLOUDFLARE_ACCOUNT_ID=
